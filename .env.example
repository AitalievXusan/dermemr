# Настройки DermEMR. Скопируйте в .env (start.bat делает это автоматически).

# Порт локального сервера: http://localhost:3000
PORT=3000
# 0.0.0.0 — доступ из локальной сети (смартфон для QR-загрузки фото); 127.0.0.1 — только этот компьютер
HOST=0.0.0.0
# Открывать браузер при запуске (1/0)
OPEN_BROWSER=1
# Адрес для QR-кодов и ссылок проверки подлинности. По умолчанию — IP компьютера в локальной сети.
# PUBLIC_URL=http://192.168.1.10:3000

# Папка с данными (пациенты, визиты, снимки, PDF, журнал аудита)
DATA_DIR=storage

# PDF: путь к Chrome / Edge, если не найден автоматически
# PDF_BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Ссылка «Записаться на повторный прием» в документах и мессенджерах
BOOKING_URL=https://clinic.example/booking

# ---- Мессенджеры. Пока токен пуст, канал работает в демо-режиме (статусы симулируются) ----
# Telegram: создайте бота у @BotFather и вставьте токен
TELEGRAM_BOT_TOKEN=

# WhatsApp Business Cloud API (Meta): токен, ID номера и одобренный шаблон с заголовком-документом
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=dermatology_visit_summary
WHATSAPP_TEMPLATE_LANG=ru
WHATSAPP_VERIFY_TOKEN=dermemr

# MAX: токен бота с business.max.ru
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api.max.ru

{
  "name": "dermemr",
  "private": true,
  "version": "1.0.0",
  "description": "DermEMR — онлайн медицинская карта приема дерматолога (рабочее место врача, касса, PDF, отправка пациенту)",
  "type": "module",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "start": "node server/dist/server.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "reset-demo": "node scripts/reset-demo.mjs"
  },
  "dependencies": {
    "puppeteer-core": "^24.0.0 || ^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": ">=0.24.0 <1.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
